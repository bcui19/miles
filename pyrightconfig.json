{
  "include": [
    "packages/nanorollout",
    "packages/orchestrator",
    "packages/miles/miles/router",
    "packages/miles/miles/true_on_policy",
    "packages/miles/miles/utils",
    "packages/miles/miles/ray"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "baseline-submodules",
    "**/build",
    "**/dist",
    "**/external",
    "**/*_pb2.py",
    "**/*_pb2_grpc.py"
  ],
  "stubPath": "typings",
  "pythonVersion": "3.12",
  "typeCheckingMode": "standard",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
